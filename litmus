    ArtifactState.VERIFIED: {ArtifactState.ATTESTED},
    ArtifactState.ATTESTED: set(),
    ArtifactState.QUARANTINED: {ArtifactState.REVOKED},
    ArtifactState.REVOKED: set(),
}

class StateMachine:
    def can_transition(self, src: ArtifactState, dst: ArtifactState) -> bool:
        return dst in ALLOWED_TRANSITIONS.get(src, set())

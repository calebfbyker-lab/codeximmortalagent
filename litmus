from bioskillengine.enums import ArtifactState

ALLOWED_TRANSITIONS = {
    ArtifactState.REQUESTED: {ArtifactState.GRAPHED},
    ArtifactState.GRAPHED: {ArtifactState.COMPILED},
    ArtifactState.COMPILED: {ArtifactState.EDITED},

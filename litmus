# CODEX-TAG: CALEB-FEDOR-BYKER-KONEV-10271998-CODEXIMMORTAL
import hashlib
import json
import uuid
from pydantic import BaseModel
from bioskillengine.schemas.artifact import CryptoEnvelope, SkillGenomeArtifact
from bioskillengine.enums import ArtifactState
from bioskillengine.schemas.payload_plan import PayloadPlan
from bioskillengine.schemas.skill_graph import SkillGraph

def stable_hash(model: BaseModel | dict) -> str:
    data = model.model_dump(mode="json") if isinstance(model, BaseModel) else model
    blob = json.dumps(data, sort_keys=True, separators=(",", ":")).encode()
    return "sha3_256:" + hashlib.sha3_256(blob).hexdigest()

class PQCEnvelopeService:
    def seal(self, graph: SkillGraph, plan: PayloadPlan) -> SkillGenomeArtifact:
        merkle_seed = {"graph_id": graph.graph_id, "plan_id": plan.plan_id}
        envelope = CryptoEnvelope(
            signature_ref=f"mldsa://sig/{uuid.uuid4().hex[:10]}",
            envelope_key_ref=f"mlkem://env/{uuid.uuid4().hex[:10]}",
            merkle_root=stable_hash(merkle_seed),
            shard_manifest_id=f"dist_{uuid.uuid4().hex[:10]}",
        )
        return SkillGenomeArtifact(
            artifact_id=f"sga_{uuid.uuid4().hex[:12]}",
            graph_hash=stable_hash(graph),
            payload_plan_hash=stable_hash(plan),
            classification=graph.classification,
            editor_mode=plan.editor_mode,
            state=ArtifactState.SEALED,
            crypto=envelope,
        )

# CODEX-TAG: CALEB-FEDOR-BYKER-KONEV-10271998-CODEXIMMORTAL
from bioskillengine.enums import ArtifactState, EditorMode
from bioskillengine.schemas.api import DecomposeRequest
from bioskillengine.services.base_editor import BaseEditorAgent
from bioskillengine.services.compiler import GeneticCryptoCompiler
from bioskillengine.services.decomposer import SkillDecomposer
from bioskillengine.services.human_gate_adapter import HumanGateAdapter
from bioskillengine.services.lineage_service import LineageService
from bioskillengine.services.nft_adapter import NFTAdapter
from bioskillengine.services.policy_guard import PolicyGuard
from bioskillengine.services.pqc_envelope import PQCEnvelopeService
from bioskillengine.services.prime_editor import PrimeEditorAgent
from bioskillengine.services.shard_adapter import ShardAdapter
from bioskillengine.services.verifier import Verifier
from bioskillengine.orchestrator.consensus_bridge import ConsensusBridge

class BioSkillWorkflow:
    def __init__(self) -> None:
        self.decomposer = SkillDecomposer()
        self.compiler = GeneticCryptoCompiler()
        self.base_editor = BaseEditorAgent()
        self.prime_editor = PrimeEditorAgent()
        self.guard = PolicyGuard()
        self.envelope = PQCEnvelopeService()
        self.shards = ShardAdapter()
        self.verifier = Verifier()
        self.gate = HumanGateAdapter()
        self.nft = NFTAdapter()
        self.lineage = LineageService()
        self.consensus = ConsensusBridge()

    def decompose(self, skill_name: str, mission_context: str, classification: str):
        return self.decomposer.decompose(
            DecomposeRequest(skill_name=skill_name, mission_context=mission_context, classification=classification)
        )

    def compile(self, skill_name: str, mission_context: str, classification: str):
        graph = self.decompose(skill_name, mission_context, classification)
        plan = self.compiler.compile(graph)
        return {"graph": graph.model_dump(), "plan": plan.model_dump()}

    def run(self, skill_name: str, mission_context: str, classification: str):
        graph = self.decompose(skill_name, mission_context, classification)
        plan = self.compiler.compile(graph)

        if plan.editor_mode == EditorMode.BASE:
            plan = self.base_editor.apply(plan)
        else:
            plan = self.prime_editor.apply(plan)

        artifact = self.envelope.seal(graph, plan)
        artifact.state = ArtifactState.PENDING_HUMAN_GATE if self.guard.require_human_gate(
            graph.classification, graph.constraints
        ) else ArtifactState.VERIFIED

        shard_receipt = self.shards.distribute(artifact.artifact_id)
        consensus = self.consensus.evaluate(artifact.artifact_id)
        gate_request = self.gate.request_gate(artifact.artifact_id, "BIO domain promotion requires approval")
        verification = self.verifier.verify(graph, plan, artifact)
        metadata = self.nft.build_metadata(artifact.artifact_id, artifact.classification)
        lineage = self.lineage.create(artifact.artifact_id, graph.graph_id, plan.plan_id)

        return {
            "graph": graph.model_dump(),
            "plan": plan.model_dump(),
            "artifact": artifact.model_dump(),
            "shard_receipt": shard_receipt,
            "consensus": consensus,
            "gate_request": gate_request,
            "verification": verification.model_dump(),
            "nft_metadata": metadata,
            "lineage": lineage.model_dump(),
        }

    def verify_only(self, skill_name: str, mission_context: str, classification: str):
        result = self.run(skill_name, mission_context, classification)
        return result["verification"]

    def promote(self, artifact_id: str, operator_id: str, justification: str, approve: bool):
        gate = self.gate.resolve_gate(artifact_id, operator_id, approve, justification)
        if not self.guard.promote_allowed(approve):
            return {
                "artifact_id": artifact_id,
                "status": "DENIED",
                "gate": gate,
            }

        metadata = self.nft.build_metadata(artifact_id, "BIO-SENSITIVE")
        minted = self.nft.mint(metadata)
        lineage = self.lineage.create(artifact_id, "graph_promoted", "plan_promoted", nft_ref=str(minted["tokenid"]))
        return {
            "artifact_id": artifact_id,
            "status": "ATTESTED",
            "gate": gate,
            "minted": minted,
            "lineage": lineage.model_dump(),
            "state": ArtifactState.ATTESTED,
        }
```


from __future__ import annotations

from dataclasses import dataclass, asdict
from statistics import mean
from typing import Dict, List

from neural_fabric.human_gate import HumanGate
from neural_fabric.learning.collector import TrainingSample


@dataclass
class TrainingBatch:
    batch_id: str
    samples: List[TrainingSample]
    statistics: Dict[str, float]
    quality_report: Dict[str, float]
    nft_lineage_proofs: List[str]


class BatchManager:
    def __init__(self, human_gate: HumanGate):
        self.human_gate = human_gate

    def assemble_batch(self, samples: List[TrainingSample], min_samples: int = 2, max_samples: int = 100) -> TrainingBatch:
        selected = samples[:max_samples]
        if len(selected) < min_samples:
            raise ValueError("Not enough samples to assemble batch.")

        stats = {
            "count": float(len(selected)),
            "avg_quality": round(mean(s.quality_score for s in selected), 3),
        }
        quality_report = {
            "min_quality": min(s.quality_score for s in selected),
            "max_quality": max(s.quality_score for s in selected),
        }
        lineage = [s.provenance_nft for s in selected]

        return TrainingBatch(
            batch_id=f"batch-{len(selected)}-{int(stats['avg_quality'] * 1000)}",
            samples=selected,
            statistics=stats,
            quality_report=quality_report,
            nft_lineage_proofs=lineage,
        )

    def submit_for_approval(self, batch: TrainingBatch):
        return self.human_gate.request_approval(
            gate_id=batch.batch_id,
            operation="learning-batch-approval",
            context={
                "batch_id": batch.batch_id,
                "sample_count": len(batch.samples),
                "avg_quality": batch.statistics["avg_quality"],
            },
            timeout_seconds=3600,
            required_approvers=1,
        )

    def on_approved(self, batch: TrainingBatch) -> Dict:
        return {
            "batch_id": batch.batch_id,
            "status": "approved_for_fine_tune",
            "sample_count": len(batch.samples),
            "lineage_count": len(batch.nft_lineage_proofs),
        }

    def as_dict(self, batch: TrainingBatch) -> Dict:
        data = asdict(batch)
        data["samples"] = [asdict(s) for s in batch.samples]
        return data
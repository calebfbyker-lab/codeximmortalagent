from __future__ import annotations

from contextlib import contextmanager
from dataclasses import dataclass, field
from functools import wraps
from time import perf_counter
from typing import Any, Callable, Dict, List


@dataclass
class MetricEvent:
    name: str
    value: float
    attributes: Dict[str, Any] = field(default_factory=dict)


@dataclass
class SpanEvent:
    name: str
    duration_ms: float
    attributes: Dict[str, Any] = field(default_factory=dict)


class TelemetryRegistry:
    def __init__(self) -> None:
        self.metrics: List[MetricEvent] = []
        self.spans: List[SpanEvent] = []

    def record_metric(self, name: str, value: float, **attributes: Any) -> None:
        self.metrics.append(MetricEvent(name=name, value=value, attributes=attributes))

    def record_span(self, name: str, duration_ms: float, **attributes: Any) -> None:
        self.spans.append(SpanEvent(name=name, duration_ms=duration_ms, attributes=attributes))


telemetry = TelemetryRegistry()


def _timed_span(span_name: str, **attrs: Any):
    def decorator(func: Callable[..., Any]) -> Callable[..., Any]:
        @wraps(func)
        def wrapper(*args: Any, **kwargs: Any) -> Any:
            start = perf_counter()
            result = func(*args, **kwargs)
            duration_ms = (perf_counter() - start) * 1000
            telemetry.record_span(span_name, duration_ms, function=func.__name__, **attrs)
            return result
        return wrapper
    return decorator


def trace_agent_call(agent_name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
    return _timed_span("codex.agent.call", agent=agent_name)


def trace_ooda_phase(phase_name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
    return _timed_span("codex.ooda.phase", phase=phase_name)


def trace_consensus(func: Callable[..., Any]) -> Callable[..., Any]:
    return _timed_span("codex.consensus.round")(func)


@contextmanager
def measure_ooda_loop():
    start = perf_counter()
    try:
        yield
    finally:
        duration_ms = (perf_counter() - start) * 1000
        telemetry.record_metric("codex.ooda.loop_duration", duration_ms)


def record_anomaly_score(score: float, node: str = "SENTINEL") -> None:
    telemetry.record_metric("codex.anomaly.score", score, node=node)


def record_consensus_vote(vote: str, agent: str) -> None:
    telemetry.record_metric("codex.consensus.vote_distribution", 1, vote=vote, agent=agent)


def record_playbook_execution(playbook_name: str, status: str) -> None:
    telemetry.record_metric("codex.playbook.executions", 1, playbook=playbook_name, status=status)


def record_nft_mint(event_type: str) -> None:

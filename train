class TrainingDataCollector:
    def capture_ooda_outcome(self, ooda_result: Dict[str, Any], was_correct: bool) -> TrainingSample:
        payload = str(ooda_result)
        sample_id = sha256(payload.encode()).hexdigest()[:16]
        return TrainingSample(
            sample_id=sample_id,
            input_text=ooda_result["state"]["threat_input"],
            output_text=str(ooda_result["consensus"]),
            label="correct" if was_correct else "incorrect",
            quality_score=0.9 if was_correct else 0.4,
            provenance_nft=f"nft://{sample_id}",
            timestamp=datetime.now(UTC).isoformat(),
        )

    def capture_threat_resolution(self, threat_event: Dict[str, Any], resolution: str, time_to_resolve: float) -> TrainingSample:
        seed = f"{threat_event}|{resolution}|{time_to_resolve}"
        sample_id = sha256(seed.encode()).hexdigest()[:16]
        quality = max(0.1, min(1.0, 1.0 - (time_to_resolve / 10000)))
        return TrainingSample(
            sample_id=sample_id,
            input_text=str(threat_event),
            output_text=resolution,
            label="resolved",
            quality_score=round(quality, 2),
            provenance_nft=f"nft://{sample_id}",
            timestamp=datetime.now(UTC).isoformat(),
        )

    def as_dict(self, sample: TrainingSample) -> Dict[str, Any]:
        return asdict(sample)# CodexImmortal Agentic AI NFT War Lab

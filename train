from __future__ import annotations

from dataclasses import dataclass, asdict, field
from datetime import UTC, datetime, timedelta
from typing import Dict, List, Literal, Optional

from integration.notifications import Notifier, NotificationResult


DecisionValue = Literal["APPROVE", "DENY", "ESCALATE", "PENDING"]


@dataclass
class ApprovalRequest:
    gate_id: str
    operation: str
    context: Dict
    timeout_seconds: int
    created_at: str
    required_approvers: int = 1
    status: DecisionValue = "PENDING"


@dataclass
class GateDecision:
    request_id: str
    decision: DecisionValue
    operator_id: str
    justification: str
    timestamp: str
    conditions: List[str] = field(default_factory=list)


class GateRegistry:
    def __init__(self) -> None:
        self._requests: Dict[str, ApprovalRequest] = {}
        self._decisions: Dict[str, List[GateDecision]] = {}
        self._notifiers: Dict[str, List[Notifier]] = {}
        self.audit_log: List[Dict] = []

    def register_gate(self, gate_id: str, required_approvers: int, notifiers: List[Notifier]) -> None:
        self._notifiers[gate_id] = notifiers
        self.audit_log.append({
            "event": "gate_registered",
            "gate_id": gate_id,
            "required_approvers": required_approvers,
            "timestamp": datetime.now(UTC).isoformat(),
        })

    def add_request(self, request: ApprovalRequest) -> None:
        self._requests[request.gate_id] = request
        self.audit_log.append({
            "event": "gate_requested",
            "gate_id": request.gate_id,
            "operation": request.operation,
            "timestamp": datetime.now(UTC).isoformat(),
        })

    def add_decision(self, decision: GateDecision) -> None:
        self._decisions.setdefault(decision.request_id, []).append(decision)
        self.audit_log.append({
            "event": "gate_decision",
            **asdict(decision),
        })

    def get_pending_gates(self) -> List[ApprovalRequest]:
        self.timeout_handler()
        return [req for req in self._requests.values() if req.status == "PENDING"]

    def timeout_handler(self) -> None:
        now = datetime.now(UTC)
        for req in self._requests.values():
            if req.status != "PENDING":
                continue
            created = datetime.fromisoformat(req.created_at)
            if now > created + timedelta(seconds=req.timeout_seconds):
                req.status = "ESCALATE"
                self.audit_log.append({
                    "event": "gate_timeout",
                    "gate_id": req.gate_id,
                    "timestamp": now.isoformat(),
                })


class HumanGate:
    def __init__(self, registry: GateRegistry | None = None):
        self.registry = registry or GateRegistry()

    def request_approval(
        self,
        gate_id: str,
        operation: str,
        context: Dict,
        timeout_seconds: int = 1800,
        required_approvers: int = 1,
    ) -> tuple[ApprovalRequest, List[NotificationResult]]:
        request = ApprovalRequest(
            gate_id=gate_id,
            operation=operation,
            context=context,
            timeout_seconds=timeout_seconds,
            created_at=datetime.now(UTC).isoformat(),
            required_approvers=required_approvers,
        )
        self.registry.add_request(request)

        notifications: List[NotificationResult] = []
        for notifier in self.registry._notifiers.get(gate_id, []):
            notifications.append(
                notifier.send(
                    title=f"Codex Gate Request: {operation}",
                    body="Human review required for protected action.",
                    context={"gate_id": gate_id, **context},
                )
            )
        return request, notifications

    def await_decision(self, request_id: str) -> Optional[DecisionValue]:
        self.registry.timeout_handler()
        request = self.registry._requests.get(request_id)
        return request.status if request else None

    def submit_decision(
        self,
        request_id: str,
        decision: DecisionValue,
        operator_id: str,
        justification: str,
        conditions: List[str] | None = None,
    ) -> GateDecision:
        gate_decision = GateDecision(
            request_id=request_id,
            decision=decision,
            operator_id=operator_id,
            justification=justification,
            timestamp=datetime.now(UTC).isoformat(),
            conditions=conditions or [],
        )
        self.registry.add_decision(gate_decision)
        request = self.registry._requests[request_id]
        current = self.registry._decisions[request_id]

        approvals = sum(1 for item in current if item.decision == "APPROVE")
        denies = sum(1 for item in current if item.decision == "DENY")
        escalations = sum(1 for item in current if item.decision == "ESCALATE")

        if denies > 0:
            request.status = "DENY"
        elif escalations > 0:
            request.status = "ESCALATE"
        elif approvals >= request.required_approvers:
            request.status = "APPROVE"

        return gate_decision# CodexImmortal Agentic AI NFT War Lab

from __future__ import annotations

from dataclasses import replace
from typing import Iterable, List

from neural_fabric.learning.collector import TrainingSample


class DataCurator:
    SENSITIVE_TERMS = ("TOP_SECRET", "TS_SCI", "SECRET", "COMMANDER")

    def score_quality(self, sample: TrainingSample) -> float:
        base = sample.quality_score
        if sample.label == "correct":
            base += 0.05
        return round(min(base, 1.0), 2)

    def deduplicate(self, samples: Iterable[TrainingSample]) -> List[TrainingSample]:
        seen = {}
        for sample in samples:
            seen[sample.sample_id] = sample
        return list(seen.values())

    def apply_redaction(self, sample: TrainingSample) -> TrainingSample:
        redacted_input = sample.input_text
        redacted_output = sample.output_text
        for term in self.SENSITIVE_TERMS:
            redacted_input = redacted_input.replace(term, "[REDACTED]")
            redacted_output = redacted_output.replace(term, "[REDACTED]")
        return replace(sample, input_text=redacted_input, output_text=redacted_output)

    def apply_differential_privacy(self, samples: Iterable[TrainingSample], epsilon: float) -> List[TrainingSample]:
        adjusted = []
        penalty = min(0.2, 1 / max(epsilon, 1))
        for sample in samples:
            adjusted.append(replace(sample, quality_score=round(max(0.0, sample.quality_score - penalty), 2)))
        return adjusted# CodexImmortal Agentic AI NFT War Lab

NEVER_AUTOMATED = {
    "WEAPONS",
    "NAVIGATION",
    "CRYPTO_KEY",
    "FIRE_CONTROL",
    "COMMS_CRYPTO",
    "AUTONOMOUS_UAS",
}


@dataclass
class ExecutorPlan:
    phase: str
    actions: List[str]
    human_gate_required: bool
    human_gate_reasons: List[str]
    audit_targets: List[str]


class ExecutorNode:
    def execute_plan(
        self,
        threat_input: str,
        sentinel: SentinelReport,
        strategist: StrategistCOA,
        archivist: ArchivistRecord,
    ) -> ExecutorPlan:
        reasons: List[str] = []
        actions = ["collect-evidence", "update-threat-board", "prepare-attestation"]

        for domain in sentinel.domains:
            if domain in NEVER_AUTOMATED:
                reasons.append(f"never_automated:{domain}")

        if sentinel.score > 0.85:
            reasons.append("score>0.85")
        if "SPACE" in sentinel.domains:
            reasons.append("domain:SPACE")
        if "BIO" in sentinel.domains:
            reasons.append("domain:BIO")
        if "RED_TEAM" in sentinel.domains:
            reasons.append("domain:RED_TEAM")

        phase = "AUTOMATED"
        if reasons:
            phase = "HUMAN GATE"
            actions.append("pause-for-approval")
        else:
            actions.append("proceed-with-contained-automation")

        actions.append(f"bind-memory:{archivist.memory_id}")
        return ExecutorPlan(
            phase=phase,
            actions=actions,
            human_gate_required=phase == "HUMAN GATE",
            human_gate_reasons=sorted(set(reasons)),
            audit_targets=["NFT_VAULT", "ARCHIVIST_LOG", "THREAT_BOARD"],
        )

    def as_dict(
        self,
        threat_input: str,
        sentinel: SentinelReport,
        strategist: StrategistCOA,
        archivist: ArchivistRecord,
    ) -> Dict:
        return asdict(self.execute_plan(threat_input, sentinel, strategist, archivist))# CodexImmortal Agentic AI NFT War Lab

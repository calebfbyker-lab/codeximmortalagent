from dataclasses import dataclass, asdict
from typing import Dict, List

from neural_fabric.nodes.sentinel import SentinelReport


@dataclass
class StrategistCOA:
    primary_coa: str
    kill_chain_stage: str
    mitre_tags: List[str]
    ci_targets: List[str]
    rationale: str


class StrategistNode:
    def plan(self, threat_input: str, sentinel: SentinelReport) -> StrategistCOA:
        text = threat_input.lower()
        mitre_tags: List[str] = []
        ci_targets: List[str] = ["CI-003"]

        if "supply" in text:
            mitre_tags.append("T1195")
            ci_targets.append("CI-024")
        if "quantum" in text or "crypto" in text:
            mitre_tags.append("T1552")
            ci_targets.extend(["CI-001", "CI-014"])
        if "space" in text:
            mitre_tags.append("T1583")
            ci_targets.append("CI-027")
        if "bio" in text:
            mitre_tags.append("T1595")
            ci_targets.append("CI-032")
        if "wallet" in text:
            mitre_tags.append("T1649")
            ci_targets.append("CI-030")
        if "red team" in text:
            mitre_tags.append("T1592")
            ci_targets.append("CI-010")

        kill_chain_stage = "reconnaissance"
        if sentinel.severity in {"HIGH", "CRITICAL"}:
            kill_chain_stage = "actions-on-objectives"

        primary_coa = "contain-observe-harden"
        if "space" in sentinel.domains or "bio" in sentinel.domains:
            primary_coa = "escalate-isolate-govern"
        elif "CRYPTO_KEY" in sentinel.domains:
            primary_coa = "rotate-freeze-attest"

        return StrategistCOA(
            primary_coa=primary_coa,
            kill_chain_stage=kill_chain_stage,
            mitre_tags=sorted(set(mitre_tags)),
            ci_targets=sorted(set(ci_targets)),
            rationale=f"COA selected from sentinel severity={sentinel.severity} and mapped domains.",
        )

    def as_dict(self, threat_input: str, sentinel: SentinelReport) -> Dict:
        return asdict(self.plan(threat_input, sentinel))# CodexImmortal Agentic AI NFT War Lab

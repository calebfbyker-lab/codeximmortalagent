from dataclasses import dataclass, asdict
from datetime import UTC, datetime
from hashlib import sha256
from typing import Dict, List

from neural_fabric.nodes.sentinel import SentinelReport
from neural_fabric.nodes.strategist import StrategistCOA


@dataclass
class ArchivistRecord:
    memory_id: str
    proof_hash: str
    evidence_refs: List[str]
    lineage_note: str
    created_at: str


class ArchivistNode:
    def preserve(self, threat_input: str, sentinel: SentinelReport, strategist: StrategistCOA) -> ArchivistRecord:
        seed = f"{threat_input}|{sentinel.score}|{strategist.primary_coa}|{strategist.ci_targets}"
        proof_hash = sha256(seed.encode("utf-8")).hexdigest()
        memory_id = f"mem-{proof_hash[:12]}"
        evidence_refs = [f"evidence://{tag.lower()}" for tag in strategist.ci_targets[:3]]
        return ArchivistRecord(
            memory_id=memory_id,
            proof_hash=proof_hash,
            evidence_refs=evidence_refs,
            lineage_note="Bound proposal context to memory, proof, and CI lineage.",
            created_at=datetime.now(UTC).isoformat(),
        )

    def as_dict(self, threat_input: str, sentinel: SentinelReport, strategist: StrategistCOA) -> Dict:
        return asdict(self.preserve(threat_input, sentinel, strategist))# CodexImmortal Agentic AI NFT War Lab

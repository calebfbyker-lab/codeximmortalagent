from dataclasses import dataclass, asdict
from typing import Dict, List


@dataclass
class SentinelReport:
    score: float
    severity: str
    domains: List[str]
    indicators: List[str]
    rationale: str


class SentinelNode:
    KEYWORDS: Dict[str, Dict[str, object]] = {
        "wallet": {"score": 0.72, "domain": "FINANCIAL", "indicator": "wallet_drift"},
        "drift": {"score": 0.60, "domain": "FINANCIAL", "indicator": "cross_mesh_drift"},
        "supply": {"score": 0.78, "domain": "SUPPLY_CHAIN", "indicator": "vendor_anomaly"},
        "quantum": {"score": 0.83, "domain": "HNDL", "indicator": "classical_crypto_exposure"},
        "bio": {"score": 0.93, "domain": "BIO", "indicator": "bio_signal"},
        "space": {"score": 0.94, "domain": "SPACE", "indicator": "orbital_signal"},
        "weapon": {"score": 0.96, "domain": "WEAPONS", "indicator": "weapons_control_path"},
        "navigation": {"score": 0.95, "domain": "NAVIGATION", "indicator": "nav_fault"},
        "crypto_key": {"score": 0.97, "domain": "CRYPTO_KEY", "indicator": "key_fault"},
        "red team": {"score": 0.88, "domain": "RED_TEAM", "indicator": "high_grade_test"},
    }

    def analyze(self, threat_input: str) -> SentinelReport:
        text = threat_input.lower()
        score = 0.18
        domains: List[str] = []
        indicators: List[str] = []

        for keyword, meta in self.KEYWORDS.items():
            if keyword in text:
                score = max(score, float(meta["score"]))
                domains.append(str(meta["domain"]))
                indicators.append(str(meta["indicator"]))

        severity = "LOW"
        if score >= 0.90:
            severity = "CRITICAL"
        elif score >= 0.75:
            severity = "HIGH"
        elif score >= 0.50:
            severity = "MEDIUM"

        rationale = f"Detected {len(indicators)} indicator(s) from lexical triage."
        return SentinelReport(
            score=round(score, 2),
            severity=severity,
            domains=sorted(set(domains)),
            indicators=sorted(set(indicators)),
            rationale=rationale,
        )

    def as_dict(self, threat_input: str) -> Dict:
        return asdict(self.analyze(threat_input))# CodexImmortal Agentic AI NFT War Lab

def to_markdown(proposal: dict) -> str:
    phases = "
".join(
        f"  Phase {idx + 1} [{phase['label']}]: {phase['detail']}"
        for idx, phase in enumerate(proposal["implementation"])
    )
    reasons = ", ".join(proposal["human_gate_reasons"]) if proposal["human_gate_reasons"] else "None"

    return f"""--------------------------------------------------
CODEX EVOLUTION PROPOSAL
Proposed By: {proposal['proposed_by']}
CAPABILITY: {proposal['capability']}
LAYER: {proposal['layer']}
TRIGGER: {proposal['trigger']}
DESCRIPTION: {proposal['description']}
CI TARGETS: {", ".join(proposal['ci_targets'])}
DEPENDENCIES: {", ".join(proposal['dependencies']) if proposal['dependencies'] else "None"}
HUMAN GATE REQUIRED: {proposal['human_gate_required']}
HUMAN GATE REASONS: {reasons}
IMPLEMENTATION:
{phases}
PAYOFF DELTA: Shield Score +{proposal['payoff_delta']['shield_score']} | Vault Shards +{proposal['payoff_delta']['vault_shards']} | Neural Peers +{proposal['payoff_delta']['neural_peers']}
PROOF HASH: {proposal['proof_hash']}
--------------------------------------------------
RULE: The War Lab never reaches final form. Evolution = sovereignty.

[CODEX-TAG: {proposal['codex_tag']}]
"""


def main() -> None:
    parser = argparse.ArgumentParser(description="Generate a Codex Evolution Proposal.")
    parser.add_argument("capability", type=str, help="Requested capability or build objective")
    parser.add_argument("--impact-score", type=float, default=4.0, help="Estimated impact score")
    parser.add_argument("--format", choices=["json", "md"], default="md")
    parser.add_argument("--output", type=str, default="")
    args = parser.parse_args()

    settings = WarLabSettings()
    orchestrator = WarLabOrchestrator(settings=settings)
    proposal = orchestrator.build_proposal(args.capability, impact_score=args.impact_score)
    payload = asdict(proposal)

    rendered = json.dumps(payload, indent=2) if args.format == "json" else to_markdown(payload)

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(rendered)
    else:
        print(rendered)


if __name__ == "__main__":
    main()

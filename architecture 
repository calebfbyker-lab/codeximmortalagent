from dataclasses import dataclass, field
from typing import List

from config.settings import WarLabSettings


@dataclass
class ValidationResult:
    valid: bool
    errors: List[str] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)


def validate_settings(settings: WarLabSettings) -> ValidationResult:
    errors: List[str] = []
    warnings: List[str] = []

    if not settings.codex_tag:
        errors.append("codex_tag must not be empty")

    if settings.agents.context_window < 2048:
        warnings.append("context_window is below recommended minimum of 2048")

    if settings.playbooks.human_gate_score_threshold <= 0:
        errors.append("human_gate_score_threshold must be positive")

    if settings.telemetry.metrics_flush_seconds <= 0:
        errors.append("metrics_flush_seconds must be positive")

    if settings.environment == "production" and not settings.telemetry.otel_enabled:
        warnings.append("otel is disabled in production")

    if settings.storage.shard_threshold != "3-of-5":
        warnings.append("shard_threshold differs from documented 3-of-5 baseline")

    if settings.agents.consensus_normal != "4-of-4":
        warnings.append("consensus_normal differs from documented 4-of-4 baseline")

    if settings.agents.consensus_degraded != "3-of-4":
        warnings.append("consensus_degraded differs from documented 3-of-4 baseline")

    if settings.agents.consensus_escalation != "2-of-4":
        warnings.append("consensus_escalation differs from documented 2-of-4 escalation baseline")

    if not settings.playbooks.gated_domains:
        errors.append("gated_domains must not be empty")

    return ValidationResult(valid=len(errors) == 0, errors=errors, warnings=warnings)


def assert_valid_settings(settings: WarLabSettings) -> None:
    result = validate_settings(settings)
    if not result.valid:
        raise ValueError("Invalid War Lab settings: " + "; ".join(result.errors))
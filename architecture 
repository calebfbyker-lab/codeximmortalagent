class PayoffDelta:
    shield_score: float
    vault_shards: int
    neural_peers: int


@dataclass
class EvolutionProposal:
    proposed_by: str
    capability: str
    layer: str
    trigger: str
    description: str
    ci_targets: List[str]
    dependencies: List[str]
    human_gate_required: bool
    human_gate_reasons: List[str]
    implementation: List[ImplementationPhase]
    payoff_delta: PayoffDelta
    codex_tag: str
    created_at: str
    proof_hash: str = field(default="")


class WarLabOrchestrator:
    def __init__(self, settings: WarLabSettings | None = None):
        self.settings = settings or WarLabSettings()

    def resolve_targets(self, request_text: str) -> List[GoalSpec]:
        text = request_text.lower()
        matched = []
        for goal in all_goals():
            if goal.ci_id.lower() in text or goal.module_name.lower() in text:
                matched.append(goal)
        if matched:
            return matched

        keyword_hits = []
        for token in ["patent", "mesh", "reward", "space", "bio", "trust", "supply", "epoch", "claim"]:
            if token in text:
                keyword_hits.extend(find_goals_by_keyword(token))

        unique = {g.ci_id: g for g in keyword_hits}
        return list(unique.values())[:8]

    def requires_human_gate(self, goals: List[GoalSpec], impact_score: float) -> tuple[bool, List[str]]:
        reasons = []
        if impact_score > self.settings.playbooks.human_gate_score_threshold:
            reasons.append(f"impact_score>{self.settings.playbooks.human_gate_score_threshold}")
        for goal in goals:
            for domain in goal.domains:
                if domain in {"KINETIC", "BIO", "SPACE", "TS_SCI"}:
                    reasons.append(f"{goal.ci_id}:{domain}")
            if "master shard" in goal.description.lower():
                reasons.append(f"{goal.ci_id}:MASTER_SHARD_ROTATION")
        return (len(reasons) > 0, sorted(set(reasons)))

    def estimate_payoff(self, goals: List[GoalSpec]) -> PayoffDelta:
        base = max(1, len(goals))
        return PayoffDelta(
            shield_score=round(0.6 * base, 1),
            vault_shards=base * 150,
            neural_peers=base * 12,
        )

    def build_proposal(self, request_text: str, impact_score: float = 4.0) -> EvolutionProposal:
        targets = self.resolve_targets(request_text)
        if not targets:
            targets = all_goals()[:3]

        ci_targets = [g.ci_id for g in targets]
        deps = sorted({dep for g in targets for dep in g.dependencies})
        layers = sorted({g.layer for g in targets})
        human_gate_required, human_gate_reasons = self.requires_human_gate(targets, impact_score)

        implementation = [
            ImplementationPhase(
                label=self.settings.playbooks.automated_phase_label,
                detail=f"Build registry-linked artifacts for {', '.join(ci_targets)} and generate proposal/package scaffolds."
            ),
            ImplementationPhase(
                label=self.settings.playbooks.human_gate_phase_label,
                detail="Review governance-sensitive modules, domain restrictions, and deployment scope before execution."
            ),
            ImplementationPhase(
                label=self.settings.playbooks.audit_stamp_phase_label,
                detail="Emit signed JSON artifact for NFT + ZK anchor + Arweave-compatible archival lineage."
            ),
        ]

        proposal = EvolutionProposal(
            proposed_by=self.settings.agents.strategist_node,
            capability=request_text.strip(),
            layer=" + ".join(layers),
            trigger="Gap, threat, or portfolio expansion request routed through OODA governance.",
            description=(
                "This proposal converts a capability request into a governed build plan mapped to CI targets, "
                "dependencies, sovereign layers, and execution controls."
            ),
            ci_targets=ci_targets,
            dependencies=deps,
            human_gate_required=human_gate_required,
            human_gate_reasons=human_gate_reasons,
            implementation=implementation,
            payoff_delta=self.estimate_payoff(targets),
            codex_tag=self.settings.codex_tag,
            created_at=datetime.now(UTC).isoformat(),
        )
        proposal.proof_hash = self._proof_hash(proposal)
        return proposal

    def _proof_hash(self, proposal: EvolutionProposal) -> str:
        payload = str(asdict(proposal)).encode("utf-8")
        return sha256(payload).hexdigest()# CodexImmortal Agentic AI NFT War Lab

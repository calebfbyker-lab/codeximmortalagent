import argparse
import json
from dataclasses import asdict

from config.settings import WarLabSettings
from config.validator import validate_settings
from neural_fabric.runner import WarLabRunner


class MasterWarLabOrchestrator:
    def __init__(self, settings: WarLabSettings | None = None):
        self.settings = settings or WarLabSettings()
        self.runner = WarLabRunner(self.settings)

    def startup_self_test(self) -> dict:
        validation = validate_settings(self.settings)
        return {
            "config_valid": validation.valid,
            "errors": validation.errors,
            "warnings": validation.warnings,
            "shield_score": self.settings.shield_score,
            "vault_shards": self.settings.vault_shards,
            "neural_peers": self.settings.neural_peers,
            "codex_tag": self.settings.codex_tag,
        }

    def status(self) -> dict:
        return self.startup_self_test()

    def start(self, dry_run: bool = False) -> dict:
        health = self.startup_self_test()
        if dry_run:
            health["mode"] = "dry-run"
            return health
        health["mode"] = "active"
        return health

    def execute_proposal(self, capability: str, impact_score: float = 4.0) -> dict:
        return self.runner.run_ooda(capability, impact_score=impact_score)


def main() -> None:
    parser = argparse.ArgumentParser(description="CodexImmortal Master Orchestrator")
    subparsers = parser.add_subparsers(dest="command", required=True)

    start_parser = subparsers.add_parser("start")
    start_parser.add_argument("--dry-run", action="store_true")

    subparsers.add_parser("status")

    exec_parser = subparsers.add_parser("proposal")
    exec_parser.add_argument("capability", type=str)
    exec_parser.add_argument("--impact-score", type=float, default=4.0)

    args = parser.parse_args()
    orchestrator = MasterWarLabOrchestrator()

    if args.command == "start":
        result = orchestrator.start(dry_run=args.dry_run)
    elif args.command == "status":
        result = orchestrator.status()
    elif args.command == "proposal":
        result = orchestrator.execute_proposal(args.capability, args.impact_score)
    else:
        raise ValueError(f"Unsupported command: {args.command}")

    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
from dataclasses import asdict
from typing import Any, Dict, List

from agents.agent_orchestrator import WarLabOrchestrator
from config.settings import WarLabSettings
from config.validator import assert_valid_settings
from neural_fabric.consensus import AgentVote, ConsensusEngine
from neural_fabric.state import WarLabState


class WarLabRunner:
    def __init__(self, settings: WarLabSettings | None = None):
        self.settings = settings or WarLabSettings()
        assert_valid_settings(self.settings)
        self.consensus = ConsensusEngine(self.settings)
        self.orchestrator = WarLabOrchestrator(self.settings)

    def _build_initial_state(self, threat_input: str, impact_score: float) -> WarLabState:
        return {
            "threat_input": threat_input,
            "ooda_loop_count": 1,
            "anomaly_scores": {},
            "nft_evidence_refs": [],
            "human_gate_required": False,
            "human_gate_response": None,
            "messages": [],
            "ci_targets": [],
            "active_layer": "MN-NET",
            "classification": "UNCLASSIFIED",
            "impact_score": impact_score,
            "codex_tag": self.settings.codex_tag,
        }

    def run_ooda(self, threat_input: str, impact_score: float = 4.0) -> Dict[str, Any]:
        state = self._build_initial_state(threat_input, impact_score)

        proposal = self.orchestrator.build_proposal(threat_input, impact_score=impact_score)
        state["ci_targets"] = proposal.ci_targets

        votes: List[AgentVote] = [
            AgentVote("SENTINEL", "APPROVE", 0.81, "No blocking anomaly detected."),
            AgentVote("STRATEGIST", "APPROVE", 0.84, "Capability aligns to registry targets."),
            AgentVote("ARCHIVIST", "APPROVE", 0.78, "Dependencies and audit lineage are resolvable."),
            AgentVote("EXECUTOR", "APPROVE", 0.76, "Execution phases are properly structured."),
        ]

        matched_domains = []
        for reason in proposal.human_gate_reasons:
            if ":" in reason:
                _, domain = reason.split(":", 1)
                matched_domains.append(domain)

        consensus = self.consensus.evaluate(
            votes=votes,
            impact_score=impact_score,
            domains=matched_domains,
            classification=state["classification"],
        )

        state["consensus"] = asdict(consensus)
        state["human_gate_required"] = consensus.human_gate_required or proposal.human_gate_required
        state["executor_plan"] = {
            "proposal_proof_hash": proposal.proof_hash,
            "implementation": [asdict(p) for p in proposal.implementation],
            "outcome": consensus.outcome,
        }

        return {
            "state": state,
            "proposal": asdict(proposal),
            "consensus": asdict(consensus),
        }

    def run_consensus(self, question: str, impact_score: float = 4.0) -> Dict[str, Any]:
        result = self.run_ooda(question, impact_score=impact_score)
        return result["consensus"]# CodexImmortal Agentic AI NFT War Lab

from typing import Any, Callable, Dict

from neural_fabric.runner import WarLabRunner


def build_war_lab_graph(runner: WarLabRunner | None = None) -> Dict[str, Callable[..., Any]]:
    runner = runner or WarLabRunner()

    def observe(threat_input: str, impact_score: float = 4.0) -> Dict[str, Any]:
        return runner.run_ooda(threat_input, impact_score=impact_score)

    def route(result: Dict[str, Any]) -> str:
        if result["state"]["human_gate_required"]:
            return "human_gate"
        return "audit_stamp"

    return {
        "observe": observe,
        "route": route,
    }# CodexImmortal Agentic AI NFT War Lab

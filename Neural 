from dataclasses import dataclass, asdict
from datetime import UTC, datetime
from typing import Dict, List, Literal, Optional
import uuid


DecisionValue = Literal["APPROVE", "DENY", "ESCALATE", "PENDING"]


@dataclass
class ApprovalRequest:
    gate_id: str
    operation: str
    context: Dict
    timeout_seconds: int
    created_at: str
    status: DecisionValue = "PENDING"


@dataclass
class GateDecision:
    request_id: str
    decision: DecisionValue
    operator_id: str
    justification: str
    timestamp: str
    conditions: List[str]


class HumanGate:
    def __init__(self) -> None:
        self._requests: Dict[str, ApprovalRequest] = {}
        self._decisions: Dict[str, GateDecision] = {}

    def request_approval(self, gate_id: str, operation: str, context: Dict, timeout_seconds: int = 1800) -> ApprovalRequest:
        request = ApprovalRequest(
            gate_id=gate_id,
            operation=operation,
            context=context,
            timeout_seconds=timeout_seconds,
            created_at=datetime.now(UTC).isoformat(),
        )
        self._requests[request.gate_id] = request
        return request

    def await_decision(self, request_id: str) -> Optional[GateDecision]:
        return self._decisions.get(request_id)

    def submit_decision(
        self,
        request_id: str,
        decision: DecisionValue,
        operator_id: str,
        justification: str,
        conditions: List[str] | None = None,
    ) -> GateDecision:
        gate_decision = GateDecision(
            request_id=request_id,
            decision=decision,
            operator_id=operator_id,
            justification=justification,
            timestamp=datetime.now(UTC).isoformat(),
            conditions=conditions or [],
        )
        self._decisions[request_id] = gate_decision
        if request_id in self._requests:
            self._requests[request_id].status = decision
        return gate_decision

    def get_pending_gates(self) -> List[Dict]:
        return [asdict(req) for req in self._requests.values() if req.status == "PENDING"]


def new_gate_id() -> str:
    return f"gate-{uuid.uuid4()}"# CodexImmortal Agentic AI NFT War Lab

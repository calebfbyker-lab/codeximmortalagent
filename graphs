from typing import Dict, Any
from neural_fabric.memory.schema import (
    GraphKind, ArtifactNode, OperationNode, ProofArtifactNode, MissionContextNode,
    ObservationNode, COAOptionNode, GateDecisionNode, EvidenceBundleNode, EdgeType, Edge,
)
from neural_fabric.memory.knowledge_store import KnowledgeGraphStore
from neural_fabric.memory.context_store import ContextGraphStore


class GraphBridge:
    def __init__(self, knowledge: KnowledgeGraphStore, context: ContextGraphStore) -> None:
        self.knowledge = knowledge
        self.context = context

    def emit_knowledge_event(self, action: Dict[str, Any]) -> None:
        art = ArtifactNode(
            id=f"artifact:{action.get('id', 'unknown')}",
            graph=GraphKind.KNOWLEDGE,
            classification=action.get('classification', 'SENSITIVE'),
            hash=action.get('ci_registry', {}).get('ci003', ''),
            artifact_type=action.get('type', 'ResourceActionRecord'),
        )
        op = OperationNode(
            id=f"operation:{action.get('id', 'unknown')}",
            graph=GraphKind.KNOWLEDGE,
            classification=action.get('classification', 'SENSITIVE'),
            playbook=action.get('playbook', 'resource-engine'),
            trigger=str(action.get('description', '')),
            phases_completed=1,
            outcome=action.get('outcome', 'PENDING'),
        )
        proof = ProofArtifactNode(
            id=f"proof:{action.get('id', 'unknown')}",
            graph=GraphKind.KNOWLEDGE,
            classification=action.get('classification', 'SENSITIVE'),
            proof_type="CI-013-015",
            proof_hash=action.get('ci_registry', {}).get('ci013', ''),
            public_inputs_hash=action.get('ci_registry', {}).get('ci016', ''),
        )
        self.knowledge.link_artifact_to_operation(art, op)
        self.knowledge.link_artifact_to_proof(art, proof)

    def emit_context_event(self, action: Dict[str, Any], mission_id: str, ooda_cycle: int) -> None:
        ctx = MissionContextNode(
            id=f"context:{mission_id}",
            graph=GraphKind.CONTEXT,
            classification=action.get('classification', 'SENSITIVE'),
            mission_id=mission_id,
            ooda_cycle=ooda_cycle,
            status=action.get('status', 'ACTIVE'),
        )
        obs = ObservationNode(
            id=f"obs:{action.get('id', 'unknown')}",
            graph=GraphKind.CONTEXT,
            classification=action.get('classification', 'SENSITIVE'),
            source=action.get('agent_id', 'resource-engine'),
            summary=str(action.get('description', '')),
            risk_score=float(action.get('risk_score', 0.0)),
            observed_at=action.get('timestamp', 'unknown'),
        )
        coa = COAOptionNode(
            id=f"coa:{action.get('id', 'unknown')}",
            graph=GraphKind.CONTEXT,
            classification=action.get('classification', 'SENSITIVE'),
            label=action.get('recommended_action', 'MONITOR'),
            confidence=float(action.get('confidence', 0.5)),
            blast_radius=float(action.get('blast_radius', 0.1)),
            recommended=True,
        )
        gate = GateDecisionNode(
            id=f"gate:{action.get('id', 'unknown')}",
            graph=GraphKind.CONTEXT,
            classification=action.get('classification', 'SENSITIVE'),
            gate_type=action.get('gate_type', 'STANDARD'),
            required=bool(action.get('human_gate_required', False)),
            approver_role=action.get('approver_role', 'COMMANDER'),
            decision=action.get('gate_decision', 'PENDING_HUMAN'),
        )
        evidence = EvidenceBundleNode(
            id=f"evidence:{action.get('id', 'unknown')}",
            graph=GraphKind.CONTEXT,
            classification=action.get('classification', 'SENSITIVE'),
            bundle_hash=action.get('ci_registry', {}).get('ci006', ''),
            artifact_refs={"artifact": f"artifact:{action.get('id', 'unknown')}"},
            alert_count=int(action.get('alert_count', 1)),
            created_at=action.get('timestamp', 'unknown'),
        )
        self.context.link_observation_to_context(obs, ctx)
        self.context.link_evidence_to_coa(evidence, coa)
        self.context.link_gate_to_coa(gate, coa)# CodexImmortal Agentic AI NFT War Lab

from typing import Dict, List
from .schema import (
    BaseNode,
    Edge,
    EdgeType,
    GraphKind,
)


class KnowledgeStore:
    def __init__(self) -> None:
        self.nodes: Dict[str, BaseNode] = {}
        self.edges: List[Edge] = []

    def upsert_node(self, node: BaseNode) -> None:
        if node.graph != GraphKind.KNOWLEDGE:
            raise ValueError("Node must belong to knowledge graph")
        self.nodes[node.id] = node

    def add_edge(self, edge: Edge) -> None:
        self.edges.append(edge)

    def get_node(self, node_id: str) -> BaseNode | None:
        return self.nodes.get(node_id)

    def neighbors(self, node_id: str, edge_type: EdgeType | None = None) -> List[BaseNode]:
        result = []
        for e in self.edges:
            if e.source == node_id and (edge_type is None or e.edge_type == edge_type):
                target = self.nodes.get(e.target)
                if target is not None:
                    result.append(target)
        return result

    def export_jsonld(self) -> dict:
        graph: List[dict] = []
        for node in self.nodes.values():
            graph.append(node.to_jsonld())
        for edge in self.edges:
            graph.append(edge.to_jsonld())
        return {
            "@context": {
                "id": "@id",
                "type": "@type",
                "edgeType": "ci:edgeType",
            },
            "@graph": graph,
        }

    def import_jsonld(self, data: dict, node_factory: callable) -> None:
        self.nodes.clear()
        self.edges.clear()
        for item in data.get("@graph", []):
            if item.get("@type") == "Edge":
                edge = Edge(
                    source=item["source"],
                    target=item["target"],
                    edge_type=EdgeType(item["edgeType"]),
                )
                self.add_edge(edge)
            else:
                node = node_factory(item)
                self.upsert_node(node)# CodexImmortal Agentic AI NFT War Lab
